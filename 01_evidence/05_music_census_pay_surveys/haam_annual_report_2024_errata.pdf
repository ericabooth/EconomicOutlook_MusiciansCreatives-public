   </dc:date>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">HAAM hosted its 3rd annual HAAM Loves You! health fair at the HAAM headquarters. Ten partner organizations offer health and wellness services for musicians, including hearing screenings and fittings for custom filtered ear plugs.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>HAAM</rdf:li>
     <rdf:li>health fair</rdf:li>
     <rdf:li>musicians</rdf:li>
     <rdf:li>vendors</rdf:li>
     <rdf:li>massage</rdf:li>
     <rdf:li>Estes Audiology</rdf:li>
    </rdf:Bag>
   </dc:subject>
