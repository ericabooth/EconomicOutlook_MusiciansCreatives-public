\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}The same state office commits far more to film than to music}{36}{subsection.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Texas dedications for the 2026--27 biennium, nominal dollars. Sources: General Appropriations Act riders; Senate Bill 22, 89th Legislature, 2025. How to read it: all three amounts are dedicated for fiscal 2026--27, so they are already in comparable nominal terms and no inflation adjustment is needed. Caveat: the film workforce line is a one-time fiscal 2026 grant to universities rather than an ongoing per-biennium dedication, it has no music counterpart, and it is never summed with the other two.\relax }}{36}{figure.caption.18}\protected@file@percent }
\newlabel{fig:filmmusic}{{18}{36}{Texas dedications for the 2026--27 biennium, nominal dollars. Sources: General Appropriations Act riders; Senate Bill 22, 89th Legislature, 2025. How to read it: all three amounts are dedicated for fiscal 2026--27, so they are already in comparable nominal terms and no inflation adjustment is needed. Caveat: the film workforce line is a one-time fiscal 2026 grant to universities rather than an ongoing per-biennium dedication, it has no music counterpart, and it is never summed with the other two.\relax }{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}A statutory cap is not a measure of support}{36}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces State music incentives per resident, authorised against actually awarded, claimed or appropriated, five states, 2025 dollars, with general state arts agency funding shown separately below. Sources: state statutes and agency reports; National Assembly of State Arts Agencies; Census Bureau population estimates for July 2025. How to read it: the upper panel shows what each state's music-specific program allows against what it paid, and the lower panel is general arts funding, a different measure that does not add to the upper one. Caveats: the New York authorised figure is a proxy derived from a budget increase rather than a flat annual cap; the Tennessee bars combine film, television and music scoring with no music-only breakout available, so they are an upper bound.\relax }}{37}{figure.caption.19}\protected@file@percent }
\newlabel{fig:statepercap}{{19}{37}{State music incentives per resident, authorised against actually awarded, claimed or appropriated, five states, 2025 dollars, with general state arts agency funding shown separately below. Sources: state statutes and agency reports; National Assembly of State Arts Agencies; Census Bureau population estimates for July 2025. How to read it: the upper panel shows what each state's music-specific program allows against what it paid, and the lower panel is general arts funding, a different measure that does not add to the upper one. Caveats: the New York authorised figure is a proxy derived from a budget increase rather than a flat annual cap; the Tennessee bars combine film, television and music scoring with no music-only breakout available, so they are an upper bound.\relax }{figure.caption.19}{}}
