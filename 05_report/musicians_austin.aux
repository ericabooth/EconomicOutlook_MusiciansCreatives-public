\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Rents rose sharply, then fell further than in any comparison metro}{14}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Real market rent indexed to each metro's own January 2015 level, 2025 dollars, through June 2026. Source: Zillow Observed Rent Index (ZORI), seasonally adjusted, deflated with the national Consumer Price Index for All Urban Consumers. How to read it: each line shows how far that metro's real rent has moved from its own 2015 starting point, so the lines compare trajectories rather than rent levels. Note on timing: Austin's real peak is December 2021, about a year before the widely quoted nominal peak, because deflating during the sharp inflation of 2021 to 2023 shifts the turning point earlier. Both readings are correct and answer different questions. Caveat: the small step every line takes at each January is the annual deflator changing, not a change in rents, because a single year-average price index is applied to twelve months of rent data.\relax }}{15}{figure.caption.4}\protected@file@percent }
\newlabel{fig:metrorent}{{4}{15}{Real market rent indexed to each metro's own January 2015 level, 2025 dollars, through June 2026. Source: Zillow Observed Rent Index (ZORI), seasonally adjusted, deflated with the national Consumer Price Index for All Urban Consumers. How to read it: each line shows how far that metro's real rent has moved from its own 2015 starting point, so the lines compare trajectories rather than rent levels. Note on timing: Austin's real peak is December 2021, about a year before the widely quoted nominal peak, because deflating during the sharp inflation of 2021 to 2023 shifts the turning point earlier. Both readings are correct and answer different questions. Caveat: the small step every line takes at each January is the annual deflator changing, not a change in rents, because a single year-average price index is applied to twelve months of rent data.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}The payroll wage understates what rent takes from musicians}{15}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Hours of work at the median hourly wage needed to cover one month of Austin one-bedroom Fair Market Rent. Sources: Bureau of Labor Statistics Occupational Employment and Wage Statistics for the Austin metro; HUD Fair Market Rents; and the City of Austin's purchased earnings series, dataset \texttt  {2qxc-8cme}. Wages and rents are matched within year in nominal terms, because the ratio of two same-year dollar figures needs no inflation adjustment. How to read it: a higher line means rent costs more hours of work. Critical caveat: the federal wage series counts payroll jobs only and excludes the self-employed, who are 72.2\%\xspace  \ (+/- 10.3 points\xspace  ) of employed Austin-metro musicians aged 18 to 64 over 2020 to 2024, and the Austin musician estimate rests on between about 100 and 700 payroll jobs depending on the year, and 120\xspace  \ in 2025, which makes it volatile from year to year. The city's own purchased earnings series, which appears to include self-employment income, exists for only two years and is not plotted; in 2017 it put musician pay at 57.0\%\xspace  \ of the federal figure for the same occupation.\relax }}{16}{figure.caption.5}\protected@file@percent }
\newlabel{fig:rentwages}{{5}{16}{Hours of work at the median hourly wage needed to cover one month of Austin one-bedroom Fair Market Rent. Sources: Bureau of Labor Statistics Occupational Employment and Wage Statistics for the Austin metro; HUD Fair Market Rents; and the City of Austin's purchased earnings series, dataset \texttt {2qxc-8cme}. Wages and rents are matched within year in nominal terms, because the ratio of two same-year dollar figures needs no inflation adjustment. How to read it: a higher line means rent costs more hours of work. Critical caveat: the federal wage series counts payroll jobs only and excludes the self-employed, who are \NPumsAustinMusSelfemp \^^M(\NPumsAustinMusSelfempMoe ) of employed Austin-metro musicians aged 18 to 64 over 2020 to 2024, and the Austin musician estimate rests on between about 100 and 700 payroll jobs depending on the year, and \NEmpPayrollMusiciansAustinLast \ in 2025, which makes it volatile from year to year. The city's own purchased earnings series, which appears to include self-employment income, exists for only two years and is not plotted; in 2017 it put musician pay at \NColAnchorCityWageVsOewsTwoZeroOneSeven \ of the federal figure for the same occupation.\relax }{figure.caption.5}{}}
