>     subtitle("Top: 8-state comparison for 2023, Texas highlighted; dashed lin
> e is the US average." ///
>              "Bottom: Texas value added, nominal dollars of each year, not ad
> justed for inflation.", $SUBOPT) ///
>     graphregion(color(white)) ///
>     name(g_fig17, replace)

