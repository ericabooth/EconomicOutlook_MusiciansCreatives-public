> _p7ky-riuq.csv"

. 
. * Repeated in the note of every registry row resting on this survey, so no
. * number can travel into the report without its provenance. There is not one
. * ASCII apostrophe anywhere in this file: one inside a local macro breaks mac
> ro
. * expansion, and this string is passed through several.
. local CAV "2022 Greater Austin Music Census, self-selected online convenience
>  sample fielded 15 Jul - 12 Sep 2022, 2,227 respondent records, NO SURVEY WEI
> GHTS. Every figure is a sample share, not a population estimate, and none is 
> comparable with ACS, PUMS, OEWS or QCEW."

. 
. 
. * ============================================================== 0. HELPERS =
> =
. * Thin wrappers over numadd so the ledger formats consistently. This survey h
> as
. * no design weights and no replicate weights, so no margin of error is ever
. * attached: inventing one would imply a probability sample that does not exis
> t.
. 
. capture program drop cnum

. program define cnum
  1.     syntax , KEY(string) VALUE(real) [UNIT(string) SOURCE(string) NOTE(str
> ing)]
  2.     if "`unit'" == "" local unit "respondents"
  3.     numadd, key(`key') value(`=string(`value',"%18.0g")') ///
>             formatted("`=strtrim(string(round(`value'),"%15.0fc"))'") ///
>             unit("`unit'") source("`source'") note("`note'")
  4. end

. 
. capture program drop cpct

. program define cpct
  1.     * value arrives already on a 0-100 scale.
.     syntax , KEY(string) VALUE(real) [SOURCE(string) NOTE(string)]
  2.     numadd, key(`key') value(`=string(`value',"%18.0g")') ///
>             formatted("`=strtrim(string(`value',"%9.1f"))'%") ///
>             unit("percent of the denominator named in the note") ///
>             source("`source'") note("`note'")
  3. end

. 
. capture program drop cusd

. program define cusd
  1.     * char(36) is a dollar sign. Writing it literally would let Stata try 
> to
.     * expand it as a global macro.
.     syntax , KEY(string) VALUE(real) [UNIT(string) SOURCE(string) NOTE(string
> )]
  2.     if "`unit'" == "" local unit "2025 dollars"
  3.     local f = char(36) + strtrim(string(round(`value'), "%15.0fc"))
  4.     numadd, key(`key') value(`=string(`value',"%18.0g")') formatted("`f'")
>  ///
>             unit("`unit'") source("`source'") note("`note'")
  5. end

. 
. capture program drop keyify

. program define keyify, rclass
  1.     * Turn a human label into a legal registry key: letters, digits, under
> scores.
.     syntax , TEXT(string)
  2.     local s = lower("`text'")
  3.     foreach bad in "," "." "(" ")" "/" "-" ":" ";" {
  4.         local s : subinstr local s "`bad'" "", all
  5.     }
  6.     local s : subinstr local s " " "_", all
  7.     while strpos("`s'", "__") > 0 {
  8.         local s : subinstr local s "__" "_", all
  9.     }
 10.     return local key "`s'"
 11. end

