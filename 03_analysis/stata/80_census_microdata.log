. * --- subgroup breakouts and independence tests ---------------------------
. tempname rtf

. tempfile rttab

. postfile `rtf' str30 varlab str40 grouplab int n double pct_stay int n_cont /
> //
>     double pct_continue double chi2 double pval int df using `rttab', replace
(file /var/folders/5n/6s4drlks0734vkn04zv4l0tr0000gp/T//St28869.00000a not
    found)

. 
. capture program drop retbreak

. program define retbreak
  1.     syntax varname(numeric), RTF(string) VARLAB(string)
  2.     quietly tabulate `varlist' stayaus, chi2
  3.     local c = r(chi2)
  4.     local p = r(p)
  5.     local d = (r(r)-1)*(r(c)-1)
  6.     quietly levelsof `varlist', local(gl)
  7.     foreach g of local gl {
  8.         quietly count if `varlist' == `g' & stayaus < .
  9.         local n = r(N)
 10.         quietly count if `varlist' == `g' & stayaus == 1
 11.         local ps = 100*r(N)/`n'
 12.         quietly count if `varlist' == `g' & contmusic < .
 13.         local nc = r(N)
 14.         quietly count if `varlist' == `g' & contmusic == 1
 15.         local pc = 100*r(N)/`nc'
 16.         local lab : label (`varlist') `g'
 17.         post `rtf' ("`varlab'") ("`lab'") (`n') (`ps') (`nc') (`pc') (`c')
>  (`p') (`d')
 18.     }
 19. end

. 
. retbreak sector3,  rtf(`rtf') varlab("Primary sector")

. retbreak yrsexp,   rtf(`rtf') varlab("Years of experience")

. retbreak liveconc, rtf(`rtf') varlab("Music income from local gigs")

. retbreak wspace,   rtf(`rtf') varlab("Work space status")

. retbreak tenure,   rtf(`rtf') varlab("Housing tenure")

. retbreak insured,  rtf(`rtf') varlab("Health insurance")

. postclose `rtf'

. 
. preserve

. use `rttab', clear

. export delimited using "${TABDIR}/table_census_retention_subgroups.csv", repl
