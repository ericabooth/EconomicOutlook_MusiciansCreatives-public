    found)

. local summeans = 0

. forvalues k = 1/8 {
  2.     local L : word `k' of `SPL'
  3.     quietly summarize sp`k', detail
  4.     local summeans = `summeans' + r(mean)
  5.     post `spf' (`k') ("`L'") (r(N)) (r(mean)) (r(p50)) (r(p75)) ///
>         (r(mean)*${DEFL22}) (r(p50)*${DEFL22}) (r(p75)*${DEFL22})
  6. }

. postclose `spf'

