. * ============================================================== 0. HELPERS =
> =
. 
. capture program drop sdrmed

. program define sdrmed, rclass
  1.     * Weighted median (or any percentile) with a successive-difference
.     * replication standard error.
.     *
.     * Stata has no svy-aware quantile estimator, so the replicate loop is don
> e
.     * by hand exactly as the Census Bureau's PUMS documentation specifies:
.     * recompute the statistic under each of the 80 replicate weights and take
.     *     Var = (4/80) * sum_r (theta_r - theta_full)^2 .
.     * Centring on the full-sample estimate rather than on the mean of the
.     * replicates is the "mse" convention, matching the mse option on svyset s
> o
.     * medians and means in this module carry comparable uncertainty.
.     *
.     * About 800 of the 44.5 million replicate-weight cells in the person file
.     * are slightly negative (Census allows this; it is an artefact of the
.     * successive-difference construction). A weighted median is undefined whe
> n
.     * weights can be negative, so the weight is floored at zero inside the
.     * percentile call only. Means, shares and regressions below use the raw
.     * replicate weights through svy, which handles negatives correctly.
.     syntax varname(numeric), Sample(varname numeric) [WSTUB(name) P(real 50)]
  2.     if "`wstub'" == "" local wstub PWGTP
  3.     local x `varlist'
  4. 
.     quietly count if `sample' == 1 & !missing(`x')
  5.     return scalar n = r(N)
  6.     if r(N) == 0 {
  7.         return scalar b = .
  8.         return scalar se = .
  9.         return scalar moe = .
 10.         return scalar wtd = .
 11.         exit
 12.     }
 13.     quietly total `wstub' if `sample' == 1 & !missing(`x')
 14.     tempname W
 15.     matrix `W' = e(b)
 16.     return scalar wtd = `W'[1,1]
 17. 
.     quietly _pctile `x' [pw=`wstub'] if `sample' == 1, p(`p')
 18.     local th = r(r1)
 19.     local ss = 0
 20.     local nbad = 0
 21.     forvalues r = 1/80 {
 22.         capture quietly _pctile `x' [pw=max(`wstub'`r',0)] if `sample' == 
> 1, p(`p')
 23.         if _rc == 0 {
 24.             local ss = `ss' + (r(r1) - `th')^2
 25.         }
 26.         else {
 27.             local nbad = `nbad' + 1
 28.         }
 29.     }
 30.     return scalar b   = `th'
 31.     return scalar se  = sqrt((4/80)*`ss')
 32.     return scalar moe = 1.645*sqrt((4/80)*`ss')
 33.     return scalar nbad = `nbad'
 34. end

. 
. capture program drop pullest

. program define pullest, rclass
  1.     * Lift one estimate and its SDR standard error out of the last svy res
> ult.
.     syntax , VARiable(string)
  2.     tempname b V
  3.     matrix `b' = e(b)
  4.     matrix `V' = e(V)
  5.     local i = colnumb(`b', "`variable'")
  6.     return scalar b   = `b'[1,`i']
  7.     return scalar se  = sqrt(`V'[`i',`i'])
  8.     return scalar moe = 1.645*sqrt(`V'[`i',`i'])
  9. end

. 
. capture program drop numusd

. program define numusd
  1.     * Register a 2025-dollar figure, and its 90 percent margin of error wh
> en one
.     * is supplied. char(36) is a dollar sign; writing it literally would let
.     * Stata try to expand it as a global macro.
.     syntax , KEY(string) VALUE(real) [MOE(real -1) SOURCE(string) NOTE(string
> )]
  2.     local shown = round(`value', 100)
  3.     local f = char(36) + strtrim(string(`shown', "%15.0fc"))
  4.     numadd, key(`key') value(`=string(`value',"%18.0g")') formatted("`f'")
>  ///
>             unit("2025 dollars") source("`source'") note("`note'")
  5.     if `moe' >= 0 {
  6.         local mf = "+/- " + char(36) + strtrim(string(round(`moe',100), "%
> 15.0fc"))
  7.         numadd, key(`key'_moe) value(`=string(`moe',"%18.0g")') formatted(
> "`mf'") ///
>                 unit("2025 dollars, 90 percent margin of error") source("`sou
> rce'") ///
>                 note("90 percent MOE = 1.645 x SDR standard error from the 80
>  PUMS replicate weights. `note'")
  8.     }
  9. end

