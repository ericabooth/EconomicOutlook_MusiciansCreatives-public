    found)

. 
. forvalues k = 0/20 {
  2.     local t = `k' * 5000
  3.     quietly generate byte _below = (PERNP_2025usd < `t')
  4.     quietly summarize _below [aw=PWGTP], meanonly
  5.     local aw = r(mean)
  6.     quietly summarize _below [aw=PWGTP] if g_mus == 1, meanonly
  7.     local mu = r(mean)
  8.     quietly drop _below
  9.     post `cf' (`k') (`t') (`mu') (.) (.) (`aw')
 10. }

. postclose `cf'

. 
. * Replicate band for the musician curve, by the same successive-difference
. * formula used for the medians. Computed on a kept-down copy of the musician
. * records so the 21 x 80 recomputations stay cheap. The all-worker curve gets
>  no
. * band because its 90 percent interval is under a fifth of a point wide and
. * would render as a line.
. preserve

.     keep if base_emp == 1 & g_mus == 1
(554,602 observations deleted)

.     forvalues k = 0/20 {
  2.         local t = `k' * 5000
  3.         quietly generate byte _below = (PERNP_2025usd < `t')
  4.         quietly summarize _below [aw=PWGTP], meanonly
  5.         local th = r(mean)
  6.         local ss = 0
  7.         forvalues r = 1/80 {
  8.             quietly summarize _below [aw=max(PWGTP`r',0)], meanonly
  9.             local ss = `ss' + (r(mean) - `th')^2
 10.         }
 11.         local cdfse`k' = sqrt((4/80)*`ss')
 12.         quietly drop _below
 13.     }

. restore

. 
