. * ------------------------------------------------------------ 5. PROGRAMS --
. capture program drop numinit

. program define numinit
  1.     * Start (or restart) this module's number ledger. Called once per modu
> le so
.     * re-running a module replaces its own rows rather than appending duplica
> tes.
.     if "$CURMODULE" == "" {
  2.         display as error "numinit: set  global CURMODULE  first"
  3.         exit 198
  4.     }
  5.     quietly {
  6.         local f "${NUMDIR}/numbers_${CURMODULE}.csv"
  7.         capture erase "`f'"
  8.         file open nh using "`f'", write text replace
  9.         file write nh "key,value,formatted,unit,source,note,module" _n
 10.         file close nh
 11.     }
 12.     display as text "  ledger started: numbers_${CURMODULE}.csv"
 13. end

. 
. capture program drop numadd

. program define numadd
  1.     * Register one number the written report will quote.
.     *
.     *   numadd, key(pums_median_earnings_tx) value(22800) ///
>     *           formatted("\$22,800") unit("2025 dollars") ///
>     *           source("01_evidence/02_pums.../pums_...csv") ///
>     *           note("ACS PUMS 2020-2024 5-yr, OCCP 2752, PWGTP-weighted medi
> an")
.     *
.     * key becomes a LaTeX macro, so use letters, digits and underscores only.
.     * note must let a reader reproduce the number: population, filter, weight
> ,
.     * vintage, and any caveat.
.     syntax , KEY(string) VALUE(string) [FORMATTED(string) UNIT(string) ///
>              SOURCE(string) NOTE(string)]
  2.     if "$CURMODULE" == "" {
  3.         display as error "numadd: set  global CURMODULE  and call numinit 
> first"
  4.         exit 198
  5.     }
  6.     if "`formatted'" == "" {
  7.         local formatted "`value'"
  8.     }
  9.     * Replace any embedded double quote with an apostrophe. These fields a
> re
.     * descriptive text, never data, so substituting is safer than escaping an
> d
.     * keeps the ledger readable by any CSV parser.
.     foreach v in formatted unit source note {
 10.         local `v' : subinstr local `v' `"""' "'", all
 11.     }
 12.     quietly {
 13.         file open nh using "${NUMDIR}/numbers_${CURMODULE}.csv", write tex
> t append
 14.         file write nh `""`key'","`value'","`formatted'","`unit'","`source'
> ","`note'","${CURMODULE}""' _n
 15.         file close nh
 16.     }
 17. end

