. 
. * Event-study dummies are built by hand rather than with factor-variable
. * notation. With ib3.binid#c.svog, reghdfe expands all seventeen levels and t
> hen
. * drops one for collinearity, which silently renormalises the whole event stu
> dy
. * onto the last block instead of the intended base. Building the dummies and
. * omitting block -5 explicitly leaves no room for that.
. local esvars ""

. local eivars ""

. forvalues b = 0/17 {
  2.     local hbv = `b' - 9
  3.     quietly generate byte  es`b' = (binid == `b') * svog
  4.     quietly generate double ei`b' = (binid == `b') * intens
  5.     label variable es`b' "SVOG recipient x half-year block `hbv'"
  6.     label variable ei`b' "Award months of 2019 revenue x half-year block `
> hbv'"
  7.     if `b' != 4 {
  8.         local esvars "`esvars' es`b'"
  9.         local eivars "`eivars' ei`b'"
 10.     }
 11. }

