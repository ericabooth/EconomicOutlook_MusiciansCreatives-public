. * ===========================================================================
. * 0. HELPERS
. * ===========================================================================
. * Address and name normalisers, carried over from 30_venues.do so the two
. * modules resolve the same string to the same key. Two additions here: STATE 
> is
. * dropped alongside HIGHWAY, because the Comptroller writes Poodie’s as
. * "22308 STATE HIGHWAY 71 W" while the federal award file writes
. * "22308 Highway 71 W"; and BUILDING joins the suite-tail list.
. 
. capture program drop addrkey

. program define addrkey
  1.     syntax varname(string), GENerate(name)
  2.     quietly {
  3.         tempvar a hnum rest
  4.         generate str100 `a' = upper(itrim(trim(`varlist')))
  5.         replace `a' = ustrregexra(`a', " (STE|SUITE|UNIT|APT|BLDG|BUILDING
> |FL|FLOOR|#).*$", "")
  6.         replace `a' = ustrregexra(`a', "[^A-Z0-9 ]", " ")
  7.         replace `a' = itrim(trim(`a'))
  8.         generate str12  `hnum' = word(`a', 1)
  9.         generate str100 `rest' = trim(subinstr(`a', `hnum', "", 1))
 10.         foreach t in N S E W NE NW SE SW NB SB EB WB NORTH SOUTH EAST WEST
>  {
 11.             replace `rest' = itrim(trim(subinstr(" " + `rest' + " ", " `t'
>  ", " ", .)))
 12.         }
 13.         foreach t in ST STREET AVE AVENUE BLVD BOULEVARD DR DRIVE RD ROAD 
> LN LANE {
 14.             replace `rest' = itrim(trim(subinstr(" " + `rest' + " ", " `t'
>  ", " ", .)))
 15.         }
 16.         foreach t in WAY PKWY PARKWAY HWY HIGHWAY STATE CIR CT TRL LOOP EX
> PY FWY PL PLZ {
 17.             replace `rest' = itrim(trim(subinstr(" " + `rest' + " ", " `t'
>  ", " ", .)))
 18.         }
 19.         generate str100 `generate' = `hnum' + subinstr(`rest', " ", "", .)
 20.         replace `generate' = "" if `hnum' == "" | `rest' == ""
 21.     }
 22. end

. 
. capture program drop namekey

. program define namekey
  1.     * Strip parentheticals, punctuation, the leading article and the trail
> ing
.     * legal-entity suffixes, so ANTONE-S NIGHTCLUB, INC. and Antone-s land on
>  the
.     * same key. Legal names and trading names differ throughout both the fede
> ral
.     * award file and the city award lists.
.     syntax varname(string), GENerate(name)
  2.     quietly {
  3.         tempvar b
  4.         generate str244 `b' = upper(trim(`varlist'))
  5.         replace `b' = ustrregexra(`b', "\(.*\)", " ")
  6.         replace `b' = subinstr(`b', "/", " ", .)
  7.         replace `b' = subinstr(`b', "&", " AND ", .)
  8.         replace `b' = ustrregexra(`b', "[^A-Z0-9 ]", " ")
  9.         replace `b' = itrim(trim(`b'))
 10.         foreach t in LLC LLP LP LTD INC INCORPORATED CORP CORPORATION CO C
> OMPANY {
 11.             replace `b' = itrim(trim(ustrregexra(`b', " `t'$", " ")))
 12.         }
 13.         replace `b' = ustrregexra(`b', "[^A-Z0-9]", "")
 14.         replace `b' = ustrregexra(`b', "^THE", "")
 15.         generate str244 `generate' = `b'
 16.     }
 17. end

. 
. * Randomization inference: draw R sets of nt units without replacement from t
> he
. * pool held in the Stata matrix POOL, and leave them in the Mata external DR.
. * Kept in Mata because rejection sampling several thousand draws in pure Stat
> a
. * is slow, and kept out of a Stata matrix so no matsize limit can bite.
. capture mata: mata drop ridraws()

. mata:
------------------------------------------------- mata (type end to exit) -----
: void ridraws(real scalar R, real scalar nt)
> {
>     external real matrix DR
>     real matrix P
>     real scalar r, np
>     real colvector o
>     P  = st_matrix("POOL")
>     np = rows(P)
>     DR = J(R, nt, .)
>     for (r = 1; r <= R; r++) {
>         o = order(runiform(np, 1), 1)
>         DR[r, .] = P[o[1::nt], 1]'
>     }
> }

