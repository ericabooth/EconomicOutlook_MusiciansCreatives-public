. forvalues h = 0/9 {
  2.     local hyr = 2015 + floor(`h'/2)
  3.     local hhf = cond(mod(`h',2) == 0, "H1", "H2")
  4.     quietly generate byte hyb`h' = (hy == `h') * rr5
  5.     label variable hyb`h' "Pilot venue x `hyr'`hhf'"
  6.     if `h' != 3 local hyvars "`hyvars' hyb`h'"
  7. }

